{
  "name": "@dotdev/studio",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/utils/extend-route.ts",
    "./style.css": "./src/style.css"
  },
  "scripts": {
    "watch": "dotdev-design watch -d ./src/theme -n d -i ./src/theme/index.ts -o ./src/style.css",
    "build": "dotdev-design build -d ./src/theme -n d -i ./src/theme/index.ts -o ./src/style.css -k utilities,rules"
  },
  "dependencies": {
    "vue": "^3.5.39",
    "vue-router": "^5.2.0",
    "pinia": "^4.0.2",
    "shiki": "^4.3.1",
    "vue-component-type-helpers": "^3.3.8",
    "@dotdev/ui-kit": "workspace:*",
    "@dotdev/design": "workspace:*",
    "@dotdev/theme": "workspace:*"
  },
  "devDependencies": {
    "vite": "^8.1.1",
    "vue-component-meta": "^3.3.8"
  }
}
